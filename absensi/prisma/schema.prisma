// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AttendanceStatus {
  Hadir
  Terlambat
  Pulang
  Izin
  Alpha
}

model Employee {
  id                   Int      @id @default(autoincrement())
  name                 String
  nickname             String   @default("")
  email                String   @unique
  department           String
  pendingFingerprintId Int?     @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  attendanceRecords           AttendanceRecord[]
  webAuthnCredentials         WebAuthnCredential[]
  fingerprintVerificationLogs FingerprintVerificationLog[]

  @@index([email])
  @@map("employees")
}

model AttendanceRecord {
  id         Int       @id @default(autoincrement())
  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  name      String
  time      String
  status    AttendanceStatus
  note      String           @db.LongText
  checkedAt DateTime
  createdAt DateTime         @default(now())

  @@index([employeeId])
  @@index([status])
  @@index([checkedAt])
  @@map("attendance_records")
}

model WebAuthnCredential {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  credentialID String   @unique
  publicKey    String
  counter      Int      @default(0)
  transports   String?
  createdAt    DateTime @default(now())

  @@index([employeeId])
  @@map("webauthn_credentials")
}

model FingerprintMapping {
  id           Int      @id @default(autoincrement())
  deviceId     String?
  templateId   Int      @unique
  templateData String?  @db.LongText
  employeeId   Int?
  createdAt    DateTime @default(now())

  @@map("fingerprint_mappings")
}

model FingerprintMappingAudit {
  id                 Int      @id @default(autoincrement())
  action             String   @db.VarChar(32)
  templateId         Int
  deviceId           String?
  previousEmployeeId Int?
  employeeId         Int?
  changedAt          DateTime @default(now())

  @@index([templateId, changedAt])
  @@index([changedAt])
  @@map("fingerprint_mapping_audits")
}

model FingerprintVerificationLog {
  id         Int       @id @default(autoincrement())
  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  deviceId   String?
  templateId Int
  status     String    @default("Berhasil")
  note       String?   @db.LongText
  verifiedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([employeeId])
  @@index([templateId])
  @@index([verifiedAt])
  @@map("fingerprint_verification_logs")
}

model DeviceCommand {
  id          Int       @id @default(autoincrement())
  deviceId    String
  command     String
  templateId  Int?
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([deviceId, status])
  @@map("device_commands")
}
